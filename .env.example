# Neon connection string for the ymg_tools database (project ymg-internal,
# calm-flower-66098092, region ap-southeast-1). Get this from the Neon
# console or the Vercel<->Neon integration once it's connected.
DATABASE_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/ymg_tools?sslmode=require"

# NextAuth — generate with: npx auth secret
AUTH_SECRET=""

# Resend — for invite/reset emails (§3.6). Not the org mailbox — see
# docs/tools/PLAN.md "Invite/reset email delivery".
RESEND_API_KEY=""
AUTH_EMAIL_FROM="YMG Ops <noreply@ymg-legal.com>"

# core-api's read-only lead endpoint (§4.1). A service token, not a user
# credential — core-api validates it on GET /internal/leads.
CORE_API_URL="https://api.ymg-legal.com"
CORE_API_SERVICE_TOKEN=""

# HRMS api — employee directory lookup, never a DB-level join (§3.5/§4.1).
HRMS_API_URL="https://hrms.ymg-legal.com"
HRMS_API_SERVICE_TOKEN=""

# One-time bootstrap of the first super admin (§3.6.3). db:seed refuses to
# run if any user already exists, so these only matter on first setup —
# safe to remove from the environment afterwards.
BOOTSTRAP_SUPER_ADMIN_EMAIL="pavan@ymg-legal.com"
BOOTSTRAP_SUPER_ADMIN_PASSWORD=""
BOOTSTRAP_SUPER_ADMIN_NAME="Pavan"
